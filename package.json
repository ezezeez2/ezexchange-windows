{
  "name": "ezexchange-desktop",
  "version": "1.0.0",
  "description": "ezexchange Windows desktop application",
  "main": "main.js",
  "author": "ezexchange",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ezexchange.desktop",
    "productName": "ezexchange",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": ["main.js", "package.json", "assets/icon.png"],
    "win": {
      "target": [{"target": "nsis", "arch": ["x64"]}],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ezexchange"
    }
  }
}